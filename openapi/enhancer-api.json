{
  "openapi": "3.0.3",
  "info": {
    "title": "Enhancer API",
    "version": "2.0.0",
    "description": "Public read-only API for Enhancer badges and user looks."
  },
  "servers": [
    {
      "url": "https://api.enhancer.at"
    }
  ],
  "tags": [
    {
      "name": "Badges",
      "description": "Badges and who shows them."
    },
    {
      "name": "Users",
      "description": "How a user looks in chat."
    }
  ],
  "paths": {
    "/v1/channel/{platform}/{channel}/badges": {
      "get": {
        "tags": ["Badges"],
        "operationId": "getChannelBadges",
        "summary": "Channel badges",
        "description": "All badges of a channel. Use global as the channel to get the global badges.",
        "parameters": [
          {
            "name": "platform",
            "in": "path",
            "required": true,
            "description": "Platform.",
            "schema": {
              "type": "string",
              "enum": ["twitch", "kick"]
            },
            "example": "twitch"
          },
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "description": "Channel login or ID, or `global`.",
            "schema": {
              "type": "string"
            },
            "example": "gambit_florydy"
          }
        ],
        "responses": {
          "200": {
            "description": "Badges of the channel.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelBadges"
                },
                "example": {
                  "badges": [
                    {
                      "id": "9417260b-f97e-416d-b330-0aa05bd958a1",
                      "name": "0o",
                      "description": "",
                      "images": {
                        "1x": "https://cdn.enhancer.at/badge/c5c6…/18.webp",
                        "2x": "https://cdn.enhancer.at/badge/c5c6…/36.webp",
                        "4x": "https://cdn.enhancer.at/badge/c5c6…/72.webp"
                      },
                      "users": 3
                    },
                    {
                      "id": "22a9bdf0-9dd6-4893-8776-6f9ab992610f",
                      "name": "Ente",
                      "description": "",
                      "images": {
                        "1x": "https://cdn.enhancer.at/badge/2584…/18.webp",
                        "2x": "https://cdn.enhancer.at/badge/2584…/36.webp",
                        "4x": "https://cdn.enhancer.at/badge/2584…/72.webp"
                      },
                      "users": 1
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/badge/{badgeId}": {
      "get": {
        "tags": ["Badges"],
        "operationId": "getBadge",
        "summary": "Badge",
        "description": "One badge and the channel it belongs to.",
        "parameters": [
          {
            "name": "badgeId",
            "in": "path",
            "required": true,
            "description": "Badge ID.",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "9417260b-f97e-416d-b330-0aa05bd958a1"
          }
        ],
        "responses": {
          "200": {
            "description": "The badge.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadgeDetail"
                },
                "example": {
                  "id": "9417260b-f97e-416d-b330-0aa05bd958a1",
                  "name": "0o",
                  "description": "",
                  "images": {
                    "1x": "https://cdn.enhancer.at/badge/c5c6…/18.webp",
                    "2x": "https://cdn.enhancer.at/badge/c5c6…/36.webp",
                    "4x": "https://cdn.enhancer.at/badge/c5c6…/72.webp"
                  },
                  "platform": "twitch",
                  "channel": "gambit_florydy"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/badge/{badgeId}/users": {
      "get": {
        "tags": ["Badges"],
        "operationId": "getBadgeUsers",
        "summary": "Badge users",
        "description": "Users who show the badge in chat, 50 per page. Pass nextCursor as cursor to get the next page.",
        "parameters": [
          {
            "name": "badgeId",
            "in": "path",
            "required": true,
            "description": "Badge ID.",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "9417260b-f97e-416d-b330-0aa05bd958a1"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Users per page, 1-100.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "`nextCursor` from the previous page.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of users.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadgeUsers"
                },
                "example": {
                  "users": [
                    {
                      "id": "123456789",
                      "login": "example_viewer",
                      "displayName": "Example_Viewer",
                      "platform": "twitch"
                    }
                  ],
                  "nextCursor": "eyJhZnRlciI6IjEyMzQ1Njc4OSJ9"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/channel/{platform}/{channel}/users/{user}": {
      "get": {
        "tags": ["Users"],
        "operationId": "getUser",
        "summary": "User",
        "description": "How a user looks in chat on a channel: nickname, font, glow and badges. Use global as the channel for the global look.",
        "parameters": [
          {
            "name": "platform",
            "in": "path",
            "required": true,
            "description": "Platform.",
            "schema": {
              "type": "string",
              "enum": ["twitch", "kick"]
            },
            "example": "twitch"
          },
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "description": "Channel login or ID, or `global`.",
            "schema": {
              "type": "string"
            },
            "example": "gambit_florydy"
          },
          {
            "name": "user",
            "in": "path",
            "required": true,
            "description": "User login or ID.",
            "schema": {
              "type": "string"
            },
            "example": "igorovh"
          }
        ],
        "responses": {
          "200": {
            "description": "The user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                },
                "example": {
                  "id": "87037696",
                  "login": "igorovh",
                  "displayName": "igorovh",
                  "nickname": "igor",
                  "font": null,
                  "glow": true,
                  "badges": [
                    {
                      "id": "bb90ca1c-52ed-4fc4-a9ab-4274c8b9c394",
                      "name": "Enhancer Developer",
                      "description": "Enhancer Developer",
                      "images": {
                        "1x": "https://cdn.enhancer.at/badge/a041…/18.webp",
                        "2x": "https://cdn.enhancer.at/badge/a041…/36.webp",
                        "4x": "https://cdn.enhancer.at/badge/a041…/72.webp"
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/fonts": {
      "get": {
        "tags": ["Users"],
        "operationId": "getFonts",
        "summary": "Fonts",
        "description": "Fonts a user can pick for their nickname.",
        "responses": {
          "200": {
            "description": "Allowed fonts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fonts"
                },
                "example": {
                  "fonts": ["Bungee", "Special Elite"]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "BadgeImages": {
        "type": "object",
        "description": "WebP image URLs: `1x` is 18 px, `2x` 36 px, `4x` 72 px.",
        "required": ["1x", "2x", "4x"],
        "properties": {
          "1x": {
            "type": "string",
            "format": "uri"
          },
          "2x": {
            "type": "string",
            "format": "uri"
          },
          "4x": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "Badge": {
        "type": "object",
        "required": ["id", "name", "description", "images"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "images": {
            "$ref": "#/components/schemas/BadgeImages"
          }
        }
      },
      "ChannelBadges": {
        "type": "object",
        "required": ["badges"],
        "properties": {
          "badges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "description", "images", "users"],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "images": {
                  "$ref": "#/components/schemas/BadgeImages"
                },
                "users": {
                  "type": "integer",
                  "description": "How many users show this badge."
                }
              }
            }
          }
        }
      },
      "BadgeDetail": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "images",
          "platform",
          "channel"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "images": {
            "$ref": "#/components/schemas/BadgeImages"
          },
          "platform": {
            "type": "string",
            "enum": ["twitch", "kick"],
            "nullable": true,
            "description": "`null` for a global badge."
          },
          "channel": {
            "type": "string",
            "nullable": true,
            "description": "Channel login; `null` for a global badge."
          }
        }
      },
      "BadgeUsers": {
        "type": "object",
        "required": ["users", "nextCursor"],
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "login", "displayName", "platform"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "login": {
                  "type": "string"
                },
                "displayName": {
                  "type": "string"
                },
                "platform": {
                  "type": "string",
                  "enum": ["twitch", "kick"]
                }
              }
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "`null` on the last page."
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "login",
          "displayName",
          "nickname",
          "font",
          "glow",
          "badges"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "login": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "nickname": {
            "type": "string",
            "nullable": true,
            "description": "Custom nickname, or `null`."
          },
          "font": {
            "type": "string",
            "nullable": true,
            "description": "Font name from Fonts, or `null`."
          },
          "glow": {
            "type": "boolean"
          },
          "badges": {
            "type": "array",
            "description": "Badges the user shows in this chat.",
            "items": {
              "$ref": "#/components/schemas/Badge"
            }
          }
        }
      },
      "Fonts": {
        "type": "object",
        "required": ["fonts"],
        "properties": {
          "fonts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid `limit` or `cursor`.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Unknown channel, user or badge.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
