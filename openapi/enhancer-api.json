{
  "openapi": "3.0.3",
  "info": {
    "title": "Enhancer API",
    "version": "2.0.0",
    "description": "Public read-only API for Enhancer badges, users and appearance."
  },
  "servers": [
    {
      "url": "https://api.enhancer.at"
    }
  ],
  "tags": [
    {
      "name": "Channels",
      "description": "Badges and users of a channel or of the global scope."
    },
    {
      "name": "Users",
      "description": "Where a user has badges or appearance."
    },
    {
      "name": "Badges",
      "description": "Single badges and allowed fonts."
    }
  ],
  "paths": {
    "/v1/channel/{platform}/{channel}/badges": {
      "get": {
        "tags": ["Channels"],
        "operationId": "getChannelBadges",
        "summary": "List channel badges",
        "description": "Lists the public badges of a channel, or the global badges with `global`, with how many accounts hold each one. Sorted by `priority`, highest first.",
        "parameters": [
          {
            "name": "platform",
            "in": "path",
            "required": true,
            "description": "Platform, case-insensitive.",
            "schema": {
              "type": "string",
              "enum": ["twitch", "kick"]
            },
            "example": "twitch"
          },
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "description": "`global` for the platform-wide scope, or a channel ID or login.",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "gambit_florydy"
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "description": "Returns `304 Not Modified` when the ETag still matches.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Badges of the channel.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelBadges"
                },
                "example": {
                  "platform": "TWITCH",
                  "channel": {
                    "externalId": "136582210",
                    "login": "gambit_florydy",
                    "displayName": "Gambit_Florydy"
                  },
                  "badges": [
                    {
                      "badgeId": "22a9bdf0-9dd6-4893-8776-6f9ab992610f",
                      "name": "Ente",
                      "description": "",
                      "priority": 0,
                      "sources": {
                        "18x18": "https://cdn.enhancer.at/badge/258405c418b2d24d9c2f34105db61d9f3e7064cd5b9dcebb03e193ed0e748145/18.webp",
                        "36x36": "https://cdn.enhancer.at/badge/258405c418b2d24d9c2f34105db61d9f3e7064cd5b9dcebb03e193ed0e748145/36.webp",
                        "72x72": "https://cdn.enhancer.at/badge/258405c418b2d24d9c2f34105db61d9f3e7064cd5b9dcebb03e193ed0e748145/72.webp"
                      },
                      "holderCount": 1
                    },
                    {
                      "badgeId": "9417260b-f97e-416d-b330-0aa05bd958a1",
                      "name": "0o",
                      "description": "",
                      "priority": 0,
                      "sources": {
                        "18x18": "https://cdn.enhancer.at/badge/c5c6542f48de8cf0d507f0c93514575e67ef74de92344dbbec1752800cadb931/18.webp",
                        "36x36": "https://cdn.enhancer.at/badge/c5c6542f48de8cf0d507f0c93514575e67ef74de92344dbbec1752800cadb931/36.webp",
                        "72x72": "https://cdn.enhancer.at/badge/c5c6542f48de8cf0d507f0c93514575e67ef74de92344dbbec1752800cadb931/72.webp"
                      },
                      "holderCount": 3
                    }
                  ]
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "Weak entity tag for conditional requests.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not modified since the ETag in `If-None-Match`."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/channel/{platform}/{channel}/users": {
      "get": {
        "tags": ["Channels"],
        "operationId": "getChannelUsers",
        "summary": "List channel users",
        "description": "Lists accounts that have a badge or an appearance in the channel (or in the global scope with `global`). A channel list contains only that channel's badges; global badges are listed under `global`. Appearance is merged with the global one, as chat shows it.",
        "parameters": [
          {
            "name": "platform",
            "in": "path",
            "required": true,
            "description": "Platform, case-insensitive.",
            "schema": {
              "type": "string",
              "enum": ["twitch", "kick"]
            },
            "example": "twitch"
          },
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "description": "`global` for the platform-wide scope, or a channel ID or login.",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "gambit_florydy"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "`nextCursor` from the previous page. Omit it for the first page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "badgeId",
            "in": "query",
            "required": false,
            "description": "Only accounts that hold this badge. It must belong to the same scope.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "active",
            "in": "query",
            "required": false,
            "description": "With `true`, only accounts that currently show the badge (or, without `badgeId`, any badge of the scope). `false` is the same as leaving it out: no filter.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of users.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelUsers"
                },
                "example": {
                  "users": [
                    {
                      "externalId": "123456789",
                      "login": "example_viewer",
                      "displayName": "Example_Viewer",
                      "appearance": {
                        "customNickname": "Example",
                        "customFont": null,
                        "hasGlow": false
                      },
                      "badges": [
                        {
                          "badgeId": "9417260b-f97e-416d-b330-0aa05bd958a1",
                          "active": true
                        }
                      ]
                    }
                  ],
                  "nextCursor": "eyJhZnRlciI6IjAxOTNmNjJlLTRhYjgtN2MwMC1iZDFhLWQ0YzVlNmY3YTg5YiJ9"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/channel/{platform}/{channel}/users/{user}": {
      "get": {
        "tags": ["Channels"],
        "operationId": "getChannelUser",
        "summary": "Get a user in a channel",
        "description": "Returns one user as chat shows them in the channel: global and channel badges with `active`, and the appearance merged field by field. Use `global` as the channel for the global view. Returns `404` when the user or the channel is unknown to Enhancer. A known user with nothing set in that scope returns `200` with empty `badges` and default appearance.",
        "parameters": [
          {
            "name": "platform",
            "in": "path",
            "required": true,
            "description": "Platform, case-insensitive.",
            "schema": {
              "type": "string",
              "enum": ["twitch", "kick"]
            },
            "example": "twitch"
          },
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "description": "`global` for the platform-wide scope, or a channel ID or login.",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "gambit_florydy"
          },
          {
            "name": "user",
            "in": "path",
            "required": true,
            "description": "User ID or login.",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "igorovh"
          }
        ],
        "responses": {
          "200": {
            "description": "The user in the channel.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelUser"
                },
                "example": {
                  "platform": "TWITCH",
                  "user": {
                    "externalId": "87037696",
                    "login": "igorovh",
                    "displayName": "igorovh"
                  },
                  "channel": {
                    "externalId": "136582210",
                    "login": "gambit_florydy",
                    "displayName": "Gambit_Florydy"
                  },
                  "appearance": {
                    "customNickname": "igor",
                    "customFont": null,
                    "hasGlow": true,
                    "source": {
                      "customNickname": "global",
                      "customFont": "default",
                      "hasGlow": "global"
                    }
                  },
                  "badges": [
                    {
                      "badgeId": "bb90ca1c-52ed-4fc4-a9ab-4274c8b9c394",
                      "name": "Enhancer Developer",
                      "description": "Enhancer Developer",
                      "priority": 999,
                      "sources": {
                        "18x18": "https://cdn.enhancer.at/badge/a041897e28bf998530b7c6d7b04b27b62fbf28ca4089c56b983619252d71286f/18.webp",
                        "36x36": "https://cdn.enhancer.at/badge/a041897e28bf998530b7c6d7b04b27b62fbf28ca4089c56b983619252d71286f/36.webp",
                        "72x72": "https://cdn.enhancer.at/badge/a041897e28bf998530b7c6d7b04b27b62fbf28ca4089c56b983619252d71286f/72.webp"
                      },
                      "active": true,
                      "scope": "global"
                    },
                    {
                      "badgeId": "c3422859-640c-449a-b23a-1a637f42cdaa",
                      "name": "Enhancer Tester",
                      "description": "Enhancer Tester",
                      "priority": 997,
                      "sources": {
                        "18x18": "https://cdn.enhancer.at/badge/90db5a6086b9685707c1153d3f974cabe512c6059df492fc80879d288c20e311/18.webp",
                        "36x36": "https://cdn.enhancer.at/badge/90db5a6086b9685707c1153d3f974cabe512c6059df492fc80879d288c20e311/36.webp",
                        "72x72": "https://cdn.enhancer.at/badge/90db5a6086b9685707c1153d3f974cabe512c6059df492fc80879d288c20e311/72.webp"
                      },
                      "active": false,
                      "scope": "global"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/user/{platform}/{user}/channels": {
      "get": {
        "tags": ["Users"],
        "operationId": "getUserChannels",
        "summary": "List a user's channels",
        "description": "Returns `404` when the user is unknown to Enhancer. Lists every context where the user has a badge or an appearance: the global context first (`channel: null`), then channels. Appearance is the user's own setting in that context, not merged; `null` fields inherit.",
        "parameters": [
          {
            "name": "platform",
            "in": "path",
            "required": true,
            "description": "Platform, case-insensitive.",
            "schema": {
              "type": "string",
              "enum": ["twitch", "kick"]
            },
            "example": "twitch"
          },
          {
            "name": "user",
            "in": "path",
            "required": true,
            "description": "User ID or login.",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "igorovh"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "`nextCursor` from the previous page. Omit it for the first page.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of contexts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserChannels"
                },
                "example": {
                  "platform": "TWITCH",
                  "user": {
                    "externalId": "87037696",
                    "login": "igorovh",
                    "displayName": "igorovh"
                  },
                  "channels": [
                    {
                      "channel": null,
                      "appearance": {
                        "customNickname": "igor",
                        "customFont": null,
                        "hasGlow": true
                      },
                      "badges": [
                        {
                          "badgeId": "bb90ca1c-52ed-4fc4-a9ab-4274c8b9c394",
                          "name": "Enhancer Developer",
                          "description": "Enhancer Developer",
                          "priority": 999,
                          "sources": {
                            "18x18": "https://cdn.enhancer.at/badge/a041897e28bf998530b7c6d7b04b27b62fbf28ca4089c56b983619252d71286f/18.webp",
                            "36x36": "https://cdn.enhancer.at/badge/a041897e28bf998530b7c6d7b04b27b62fbf28ca4089c56b983619252d71286f/36.webp",
                            "72x72": "https://cdn.enhancer.at/badge/a041897e28bf998530b7c6d7b04b27b62fbf28ca4089c56b983619252d71286f/72.webp"
                          },
                          "active": true
                        },
                        {
                          "badgeId": "c3422859-640c-449a-b23a-1a637f42cdaa",
                          "name": "Enhancer Tester",
                          "description": "Enhancer Tester",
                          "priority": 997,
                          "sources": {
                            "18x18": "https://cdn.enhancer.at/badge/90db5a6086b9685707c1153d3f974cabe512c6059df492fc80879d288c20e311/18.webp",
                            "36x36": "https://cdn.enhancer.at/badge/90db5a6086b9685707c1153d3f974cabe512c6059df492fc80879d288c20e311/36.webp",
                            "72x72": "https://cdn.enhancer.at/badge/90db5a6086b9685707c1153d3f974cabe512c6059df492fc80879d288c20e311/72.webp"
                          },
                          "active": false
                        }
                      ]
                    },
                    {
                      "channel": {
                        "externalId": "87037696",
                        "login": "igorovh",
                        "displayName": "igorovh"
                      },
                      "appearance": {
                        "customNickname": "test",
                        "customFont": null,
                        "hasGlow": false
                      },
                      "badges": []
                    }
                  ],
                  "nextCursor": null
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/badge/{badgeId}": {
      "get": {
        "tags": ["Badges"],
        "operationId": "getBadge",
        "summary": "Get a badge",
        "description": "Returns one public badge and the channel it belongs to. Global badges have `scope: global` and no channel.",
        "parameters": [
          {
            "name": "badgeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "9417260b-f97e-416d-b330-0aa05bd958a1"
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "description": "Returns `304 Not Modified` when the ETag still matches.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The badge.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadgeDetail"
                },
                "example": {
                  "badgeId": "9417260b-f97e-416d-b330-0aa05bd958a1",
                  "name": "0o",
                  "description": "",
                  "priority": 0,
                  "sources": {
                    "18x18": "https://cdn.enhancer.at/badge/c5c6542f48de8cf0d507f0c93514575e67ef74de92344dbbec1752800cadb931/18.webp",
                    "36x36": "https://cdn.enhancer.at/badge/c5c6542f48de8cf0d507f0c93514575e67ef74de92344dbbec1752800cadb931/36.webp",
                    "72x72": "https://cdn.enhancer.at/badge/c5c6542f48de8cf0d507f0c93514575e67ef74de92344dbbec1752800cadb931/72.webp"
                  },
                  "scope": "channel",
                  "platform": "TWITCH",
                  "channel": {
                    "externalId": "136582210",
                    "login": "gambit_florydy",
                    "displayName": "Gambit_Florydy"
                  }
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "Weak entity tag for conditional requests.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not modified since the ETag in `If-None-Match`."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/fonts": {
      "get": {
        "tags": ["Badges"],
        "operationId": "getFonts",
        "summary": "List fonts",
        "description": "Lists the font families allowed in `customFont`. Load one from `https://fonts.enhancer.at/css2?family=<name>`, which works like the Google Fonts CSS API.",
        "responses": {
          "200": {
            "description": "Allowed fonts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fonts"
                },
                "example": {
                  "fonts": ["Black Ops One", "Bungee", "Special Elite"]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "BadgeSources": {
        "type": "object",
        "description": "Image URLs per size. See Badge images.",
        "required": ["18x18", "36x36", "72x72"],
        "properties": {
          "18x18": {
            "type": "string",
            "format": "uri"
          },
          "36x36": {
            "type": "string",
            "format": "uri"
          },
          "72x72": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "AccountRef": {
        "type": "object",
        "required": ["externalId", "login", "displayName"],
        "properties": {
          "externalId": {
            "type": "string",
            "description": "Platform ID."
          },
          "login": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "Appearance": {
        "type": "object",
        "required": ["customNickname", "customFont", "hasGlow"],
        "properties": {
          "customNickname": {
            "type": "string",
            "nullable": true
          },
          "customFont": {
            "type": "string",
            "nullable": true,
            "description": "A family from `/v1/fonts`."
          },
          "hasGlow": {
            "type": "boolean"
          }
        }
      },
      "StoredAppearance": {
        "type": "object",
        "description": "What the user set in one context. `null` means not set: a channel then inherits the global value.",
        "required": ["customNickname", "customFont", "hasGlow"],
        "properties": {
          "customNickname": {
            "type": "string",
            "nullable": true
          },
          "customFont": {
            "type": "string",
            "nullable": true
          },
          "hasGlow": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "MergedAppearance": {
        "type": "object",
        "description": "Field by field, the channel value wins and `null` falls back to the global value, then to the default. `source` says where each value came from.",
        "required": ["customNickname", "customFont", "hasGlow", "source"],
        "properties": {
          "customNickname": {
            "type": "string",
            "nullable": true
          },
          "customFont": {
            "type": "string",
            "nullable": true,
            "description": "A family from `/v1/fonts`."
          },
          "hasGlow": {
            "type": "boolean"
          },
          "source": {
            "type": "object",
            "required": ["customNickname", "customFont", "hasGlow"],
            "properties": {
              "customNickname": {
                "type": "string",
                "enum": ["channel", "global", "default"]
              },
              "customFont": {
                "type": "string",
                "enum": ["channel", "global", "default"]
              },
              "hasGlow": {
                "type": "string",
                "enum": ["channel", "global", "default"]
              }
            }
          }
        }
      },
      "ChannelBadge": {
        "type": "object",
        "required": [
          "badgeId",
          "name",
          "description",
          "priority",
          "sources",
          "holderCount"
        ],
        "properties": {
          "badgeId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "description": "Higher wins when only one badge of a scope can show."
          },
          "sources": {
            "$ref": "#/components/schemas/BadgeSources"
          },
          "holderCount": {
            "type": "integer",
            "description": "All accounts that hold the badge, whether they show it (`active`) or not."
          }
        }
      },
      "ChannelBadges": {
        "type": "object",
        "required": ["platform", "channel", "badges"],
        "properties": {
          "platform": {
            "type": "string",
            "enum": ["TWITCH", "KICK"]
          },
          "channel": {
            "$ref": "#/components/schemas/AccountRef",
            "nullable": true,
            "description": "`null` for `global`."
          },
          "badges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChannelBadge"
            }
          }
        }
      },
      "ChannelUsers": {
        "type": "object",
        "required": ["users", "nextCursor"],
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/AccountRef"
                },
                {
                  "type": "object",
                  "required": ["appearance", "badges"],
                  "properties": {
                    "appearance": {
                      "$ref": "#/components/schemas/Appearance"
                    },
                    "badges": {
                      "type": "array",
                      "description": "Badges of this scope, highest `priority` first. Details come from List channel badges.",
                      "items": {
                        "type": "object",
                        "required": ["badgeId", "active"],
                        "properties": {
                          "badgeId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "active": {
                            "type": "boolean",
                            "description": "The badge shows in chat now. Per scope a user shows one badge (the highest `priority` they did not hide) plus any badge staff pinned."
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "`null` on the last page."
          }
        }
      },
      "UserBadge": {
        "type": "object",
        "required": [
          "badgeId",
          "name",
          "description",
          "priority",
          "sources",
          "active"
        ],
        "properties": {
          "badgeId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "description": "Higher wins when only one badge of a scope can show."
          },
          "sources": {
            "$ref": "#/components/schemas/BadgeSources"
          },
          "active": {
            "type": "boolean",
            "description": "The badge shows in chat now. Per scope a user shows one badge (the highest `priority` they did not hide) plus any badge staff pinned."
          }
        }
      },
      "ChannelUser": {
        "type": "object",
        "required": ["platform", "user", "channel", "appearance", "badges"],
        "properties": {
          "platform": {
            "type": "string",
            "enum": ["TWITCH", "KICK"]
          },
          "user": {
            "$ref": "#/components/schemas/AccountRef"
          },
          "channel": {
            "$ref": "#/components/schemas/AccountRef",
            "nullable": true,
            "description": "`null` for `global`."
          },
          "appearance": {
            "$ref": "#/components/schemas/MergedAppearance"
          },
          "badges": {
            "type": "array",
            "description": "Global and channel badges, highest `priority` first.",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/UserBadge"
                },
                {
                  "type": "object",
                  "required": ["scope"],
                  "properties": {
                    "scope": {
                      "type": "string",
                      "enum": ["global", "channel"]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "UserChannels": {
        "type": "object",
        "required": ["platform", "user", "channels", "nextCursor"],
        "properties": {
          "platform": {
            "type": "string",
            "enum": ["TWITCH", "KICK"]
          },
          "user": {
            "$ref": "#/components/schemas/AccountRef"
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["channel", "appearance", "badges"],
              "properties": {
                "channel": {
                  "$ref": "#/components/schemas/AccountRef",
                  "nullable": true,
                  "description": "`null` for the global context."
                },
                "appearance": {
                  "$ref": "#/components/schemas/StoredAppearance",
                  "nullable": true
                },
                "badges": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserBadge"
                  }
                }
              }
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "`null` on the last page."
          }
        }
      },
      "BadgeDetail": {
        "type": "object",
        "required": [
          "badgeId",
          "name",
          "description",
          "priority",
          "sources",
          "scope",
          "platform",
          "channel"
        ],
        "properties": {
          "badgeId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "description": "Higher wins when only one badge of a scope can show."
          },
          "sources": {
            "$ref": "#/components/schemas/BadgeSources"
          },
          "scope": {
            "type": "string",
            "enum": ["global", "channel"]
          },
          "platform": {
            "type": "string",
            "enum": ["TWITCH", "KICK"],
            "nullable": true,
            "description": "Platform of the channel; `null` for global badges."
          },
          "channel": {
            "$ref": "#/components/schemas/AccountRef",
            "nullable": true
          }
        }
      },
      "Fonts": {
        "type": "object",
        "required": ["fonts"],
        "properties": {
          "fonts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid parameters or cursor.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "The channel, user or badge was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
