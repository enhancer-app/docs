{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":semanticCommitTypeAll(chore)"],
  "baseBranchPatterns": ["main"],
  "timezone": "Europe/Warsaw",
  "schedule": ["* 0-5 * * 1"],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "enabledManagers": ["bun"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchManagers": ["bun"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "bun non-major dependencies"
    },
    {
      "description": "Vulnerability fixes already skip the schedule and limits; also put them first",
      "matchJsonata": ["$exists(vulnerabilityFixVersion)"],
      "prPriority": 10
    }
  ]
}
